	<groupId>in.landstack</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>SIH26014 Land Stack Backend</name>
	<description>Land Stack System Backend</description>
	<properties>
